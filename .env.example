# Server-only Formspree endpoint. Keep the real value in .env.local.
FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Server-only Cloudflare Turnstile secret.
TURNSTILE_SECRET_KEY=

# Server-only hostnames returned by Turnstile siteverify.
# Use localhost,127.0.0.1 for local development.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Public Cloudflare Turnstile site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEq-M79Op5kEXocc
